<Page
    x:Class="Sefirah.Views.AdbPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sefirah.Views"
    xmlns:models="using:Sefirah.Data.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Raw ADB command console -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="ADB Console" Style="{ThemeResource SubtitleTextBlockStyle}"/>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    PlaceholderText="e.g. pm list packages -f"
                    Text="{x:Bind ViewModel.CommandInput, Mode=TwoWay}"
                    FontFamily="Consolas"
                    KeyDown="CommandInput_KeyDown"/>
                <Button
                    Grid.Column="1"
                    Content="Run"
                    Click="RunCommand_Click"/>
            </Grid>
            <ScrollViewer MaxHeight="180" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock
                    Text="{x:Bind ViewModel.CommandOutput, Mode=OneWay}"
                    FontFamily="Consolas"
                    TextWrapping="Wrap"
                    Padding="8"/>
            </ScrollViewer>
        </StackPanel>

        <!-- App list header: sort + refresh -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="Installed Apps"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                VerticalAlignment="Center"/>
            <ComboBox
                Grid.Column="1"
                SelectedIndex="0"
                SelectionChanged="SortCombo_SelectionChanged">
                <ComboBoxItem Content="Name (A-Z)" Tag="NameAscending"/>
                <ComboBoxItem Content="Name (Z-A)" Tag="NameDescending"/>
                <ComboBoxItem Content="Enabled first" Tag="EnabledFirst"/>
                <ComboBoxItem Content="Disabled first" Tag="DisabledFirst"/>
            </ComboBox>
            <Button Grid.Column="2" Content="Refresh" Click="RefreshApps_Click"/>
        </Grid>

        <!-- App list -->
        <ListView
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.InstalledApps, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:AdbAppInfo">
                    <Grid ColumnSpacing="12" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="{x:Bind PackageName}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"/>
                        <ToggleSwitch
                            Grid.Column="1"
                            Tag="{x:Bind}"
                            IsOn="{x:Bind IsEnabled}"
                            Toggled="AppEnabledToggle_Toggled"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
